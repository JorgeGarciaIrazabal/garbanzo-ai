# Production secrets + config for the garbanzo-prod stack.
# Copy to deploy/.env (gitignored) and fill in. See deploy/README.md.

# ngrok — dashboard.ngrok.com → "Your Authtoken" and your reserved static domain.
# Do NOT run a host ngrok agent at the same time (free plan = one session).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-domain.ngrok-free.app

# Prod database password. URL-safe characters only (it is interpolated into a
# DSN). Fixed after the first boot — the postgres volume keeps the original.
POSTGRES_PASSWORD=

# JWT signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated emails auto-promoted to admin on startup (optional).
ADMIN_EMAILS=

# Ollama hosted web_search/web_fetch API key (ollama.com → Settings → API keys).
# Injected into the backend container for the websearch MCP stdio server.
OLLAMA_API_KEY=

# Micro-apps: repo cloned into the stack on first boot and pulled periodically.
MICROAPPS_GIT_URL=git@github.com:JorgeGarciaIrazabal/micro-apps.git

# SSH key used for micro-apps publish (git push as your GitHub user).
# Absolute path; the key must not be group/other-readable (chmod 600).
GIT_SSH_KEY_PATH=/home/you/.ssh/id_ed25519

# Git identity for commits made by the micro-apps agent in prod.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional overrides.
#GITHUB_REPO=JorgeGarciaIrazabal/garbanzo-ai  # Releases repo for the desktop auto-updater
#MICROAPPS_OPENCODE_MODEL=ollama/kimi-k2.7-code:cloud
# Cloud models: glm-5.2:cloud, gemma4:cloud, minimax-m3:cloud,
# nemotron-3-ultra:cloud, kimi-k2.7-code:cloud — see deploy/README.md
# Model opencode uses to write the release changelog on `just deploy`. If unset,
# opencode's own configured default model is used. Falls back to a raw commit
# list if opencode or the model is unavailable. Run `opencode models` to list
# authenticated ones (e.g. ollama-cloud/kimi-k2.7-code).
#CHANGELOG_OPENCODE_MODEL=
#TZ=Europe/Madrid

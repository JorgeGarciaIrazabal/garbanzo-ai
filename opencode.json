{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.3:cloud",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "external_directory": {
      "*": "allow"
    }
  },
  "lsp": {
    "dart": {
      "command": ["dart", "language-server", "--protocol=lsp"]
    },
    "pyright": {
      "command": ["backend/.venv/bin/pyright-langserver", "--stdio"]
    },
    "ruff": {
      "command": ["backend/.venv/bin/ruff", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "mcp": {
    "websearch": {
      "type": "local",
      "command": ["uv", "run", "backend/app/mcp_stdio_servers/web_search.py"],
      "enabled": true
    },
    "dart-mcp-server": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true
    },
    "marionette": {
      "type": "local",
      "command": ["bash", "marionette_mcp"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
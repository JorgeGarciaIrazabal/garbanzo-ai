# FastAPI Settings
APP_NAME="Garbanzo AI"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (for local dev: docker compose up -d)
DATABASE_URL=postgresql+asyncpg://garbanzo:garbanzo_dev@localhost:5432/garbanzo_ai

# CORS (add Flutter web dev URL when using flutter run -d chrome, e.g. http://localhost:8080)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Dev test user — auto-created on startup when both are set (leave empty to disable)
TEST_USER_EMAIL=test@garbanzo.dev
TEST_USER_PASSWORD=testpass123

# LLM Provider (ollama, openai, etc.)
LLM_PROVIDER=ollama

# Default model for new conversations and general internal calls. Must match a
# model ID returned by GET /api/v1/chat/models.
DEFAULT_MODEL=minimax-m3:cloud

# Dedicated model for daily automatic memory extraction.
MEMORY_EXTRACTION_MODEL=glm-5.2:cloud

# Default for scheduled actions without an explicit per-action model.
SCHEDULED_ACTION_MODEL=glm-5.2:cloud

# Ollama API URL
# Use http://host.docker.internal:11434 when Ollama runs on Windows host and backend runs in WSL
# Use http://localhost:11434 when Ollama and backend are both on the same host
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama hosted web_search/web_fetch API key (ollama.com → Settings → API keys).
# Consumed by the websearch MCP stdio server (backend/app/mcp_stdio_servers/
# web_search.py), which reads it from this file. Leave empty to disable websearch.
OLLAMA_API_KEY=

# Firebase Cloud Messaging (push notifications)
# Path to the service-account JSON, relative to backend/ or absolute.
# Leave empty to disable push notifications.
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Micro-Apps Agentic Workspace
# Absolute path to the micro-apps monorepo. Leave empty to disable the whole
# feature (all /api/v1/microapps endpoints return 404).
MICROAPPS_REPO_PATH=
# Base port for per-user dev servers (each user gets base + a stable offset).
MICROAPPS_DEV_PORT_BASE=8100
# Binary used to spawn the headless opencode agent.
MICROAPPS_OPENCODE_BIN=opencode
# Git remote that publish/revert operate against.
MICROAPPS_PUBLISH_REMOTE=origin
# Directory (relative to the repo root) holding per-user worktrees.
MICROAPPS_WORKTREES_DIR=.worktrees
# opencode model id in provider/name form (bare name is seeded into opencode.json).
# Any of the cloud models work: glm-5.2:cloud, gemma4:cloud, minimax-m3:cloud,
# nemotron-3-ultra:cloud, kimi-k2.7-code:cloud.
MICROAPPS_OPENCODE_MODEL=ollama/kimi-k2.7-code:cloud
